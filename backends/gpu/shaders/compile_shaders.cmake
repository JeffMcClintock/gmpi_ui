# Regenerates the committed compiled shaders (compiled/*.cpp, compiled/shaders.h)
# from the .sc sources in this folder. Run it after changing a shader:
#
#   cmake -DSHADERC=/path/to/shaderc -P compile_shaders.cmake
#   cmake -DSHADERC=/path/to/shaderc -DRENDERERS=dxbc -P compile_shaders.cmake
#
# RENDERERS defaults to "spirv;metal", the two any host's shaderc can produce.
# dxbc (Direct3D 12) needs shaderc on Windows (the HLSL compiler is d3dcompiler).
#
# shaderc must come from the same bgfx as the build: the binary format is
# versioned. gmpi_gpu.cmake builds one when GMPI_GPU_BUILD_SHADERC is on.
#
# Consumers never run this: a build compiles the committed C++ for its
# renderer, so no shaderc and no embed step is needed to build gmpi_ui.

cmake_minimum_required(VERSION 3.20)

if (NOT DEFINED SHADERC OR NOT EXISTS "${SHADERC}")
  message(FATAL_ERROR "Pass -DSHADERC=<path to bgfx shaderc>")
endif ()
if (NOT DEFINED RENDERERS)
  set(RENDERERS spirv metal)
endif ()

set(SRC_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(OUT_DIR "${SRC_DIR}/compiled")
file(MAKE_DIRECTORY "${OUT_DIR}")
file(GLOB SHADERS "${SRC_DIR}/[vf]s_*.sc")
list(SORT SHADERS)

# shaderc profile and platform per renderer.
set(spirv_PROFILE spirv)
set(spirv_PLATFORM linux)
set(metal_PROFILE metal)
set(metal_PLATFORM osx)
set(dxbc_PROFILE s_5_0)
set(dxbc_PLATFORM windows)

execute_process(COMMAND "${SHADERC}" --version OUTPUT_VARIABLE SHADERC_VERSION ERROR_VARIABLE SHADERC_VERSION)
string(REGEX MATCH "version [0-9]+(\\.[0-9]+)*" SHADERC_VERSION "${SHADERC_VERSION}")

# Turn a compiled binary into "0x..," lines, 24 bytes per line.
function(hex_bytes BIN OUT_VAR SIZE_VAR)
  file(READ "${BIN}" HEX HEX)
  string(LENGTH "${HEX}" HEX_LENGTH)
  math(EXPR SIZE "${HEX_LENGTH} / 2")
  set(BYTES "")
  set(POS 0)
  while (POS LESS HEX_LENGTH)
    string(SUBSTRING "${HEX}" ${POS} 48 CHUNK)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," CHUNK "${CHUNK}")
    string(APPEND BYTES "    ${CHUNK}\n")
    math(EXPR POS "${POS} + 48")
  endwhile ()
  set(${OUT_VAR} "${BYTES}" PARENT_SCOPE)
  set(${SIZE_VAR} "${SIZE}" PARENT_SCOPE)
endfunction()

# ---------------------------------------------------------------------------
# USER_SHADER mode: a shader BRUSH for a module (GmpiApiShaders.h).
#
#   cmake -DSHADERC=... -DUSER_SHADER=/path/fluid.sh -DUSER_NAME=fluid \
#         -DUSER_OUT=/path/shaders_fluid.cpp [-DRENDERERS=...] -P compile_shaders.cmake
#
# USER_SHADER defines `vec4 shade(vec2 p)`. It is compiled into each host
# template (template_quad.sc, template_path.sc) for each renderer, and the
# result is ONE C++ file defining
#
#   namespace gmpi::drawing::shaders {
#     extern const gmpi::drawing::api::ShaderBlob <USER_NAME>_blobs[];
#     extern const int32_t <USER_NAME>_blobCount;
#   }
#
# which the module hands to IShaderFactory::createShaderBrush. All renderers
# go in one file so a module needs no per-platform CMake; the host picks.
# ---------------------------------------------------------------------------
if (DEFINED USER_SHADER)
  if (NOT EXISTS "${USER_SHADER}")
    message(FATAL_ERROR "USER_SHADER not found: ${USER_SHADER}")
  endif ()
  if (NOT DEFINED USER_NAME OR NOT DEFINED USER_OUT)
    message(FATAL_ERROR "USER_SHADER mode needs -DUSER_NAME=<identifier> -DUSER_OUT=<file.cpp>")
  endif ()

  # The templates include <user_shader.sh>: stage the user's file under that
  # name in a private include dir, so the file itself can be called anything.
  get_filename_component(USER_OUT_DIR "${USER_OUT}" DIRECTORY)
  set(STAGE_DIR "${USER_OUT_DIR}/.gmpi_user_shader_${USER_NAME}") # removed below
  file(MAKE_DIRECTORY "${STAGE_DIR}")
  configure_file("${USER_SHADER}" "${STAGE_DIR}/user_shader.sh" COPYONLY)

  set(CONTENTS "// Generated by gmpi_ui/backends/gpu/shaders/compile_shaders.cmake (USER_SHADER mode)\n")
  string(APPEND CONTENTS "// from ${USER_SHADER} (shaderc ${SHADERC_VERSION}). Do not edit.\n\n")
  string(APPEND CONTENTS "#include \"GmpiApiShaders.h\"\n\nnamespace gmpi::drawing::shaders {\n")
  set(TABLE "")
  set(STAGES Quad Path)
  set(Quad_TEMPLATE template_quad.sc)
  set(Path_TEMPLATE template_path.sc)
  set(spirv_ENUM Spirv)
  set(metal_ENUM Metal)
  set(dxbc_ENUM Dxbc)
  foreach (RENDERER ${RENDERERS})
    if (NOT DEFINED ${RENDERER}_PROFILE)
      message(FATAL_ERROR "Unknown renderer '${RENDERER}' (spirv, metal or dxbc)")
    endif ()
    set(OPT "")
    if (RENDERER STREQUAL "dxbc")
      set(OPT -O3)
    endif ()
    foreach (STAGE ${STAGES})
      set(BIN "${STAGE_DIR}/${USER_NAME}_${STAGE}.${RENDERER}.tmp")
      execute_process(
        COMMAND "${SHADERC}" -i "${SRC_DIR}" -i "${STAGE_DIR}" -f "${SRC_DIR}/${${STAGE}_TEMPLATE}" -o "${BIN}"
                --type f --platform ${${RENDERER}_PLATFORM} -p ${${RENDERER}_PROFILE} ${OPT}
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE LOG ERROR_VARIABLE LOG)
      if (NOT RESULT EQUAL 0)
        message(FATAL_ERROR "shaderc failed on ${${STAGE}_TEMPLATE} + ${USER_SHADER} for ${RENDERER}:\n${LOG}")
      endif ()
      hex_bytes("${BIN}" BYTES SIZE)
      file(REMOVE "${BIN}")
      set(SYM "${USER_NAME}_${RENDERER}_${STAGE}")
      string(APPEND CONTENTS "  static const uint8_t ${SYM}[] = {\n${BYTES}  };\n")
      string(APPEND TABLE "    { api::ShaderRenderer::${${RENDERER}_ENUM}, api::ShaderStage::${STAGE}, ${SYM}, ${SIZE} },\n")
    endforeach ()
  endforeach ()
  string(APPEND CONTENTS "\n  extern const api::ShaderBlob ${USER_NAME}_blobs[] = {\n${TABLE}  };\n")
  string(APPEND CONTENTS "  extern const int32_t ${USER_NAME}_blobCount = int32_t(sizeof(${USER_NAME}_blobs) / sizeof(${USER_NAME}_blobs[0]));\n")
  string(APPEND CONTENTS "}\n")
  file(WRITE "${USER_OUT}" "${CONTENTS}")
  file(REMOVE_RECURSE "${STAGE_DIR}")
  message(STATUS "wrote ${USER_OUT}")
  return()
endif ()

set(NAMES "")
foreach (SHADER ${SHADERS})
  get_filename_component(NAME ${SHADER} NAME_WE)
  list(APPEND NAMES ${NAME})
endforeach ()

foreach (RENDERER ${RENDERERS})
  if (NOT DEFINED ${RENDERER}_PROFILE)
    message(FATAL_ERROR "Unknown renderer '${RENDERER}' (spirv, metal or dxbc)")
  endif ()

  set(CONTENTS "// Generated by shaders/compile_shaders.cmake from the .sc sources. Do not edit.\n")
  string(APPEND CONTENTS "// Renderer: ${RENDERER} (shaderc ${SHADERC_VERSION}, -p ${${RENDERER}_PROFILE}).\n\n")
  string(APPEND CONTENTS "#include \"shaders.h\"\n\nnamespace gmpi::gpu::shaders {\n")

  foreach (SHADER ${SHADERS})
    get_filename_component(NAME ${SHADER} NAME_WE)
    set(TYPE v)
    if (NAME MATCHES "^fs_")
      set(TYPE f)
    endif ()
    set(BIN "${OUT_DIR}/${NAME}.${RENDERER}.tmp")
    set(OPT "")
    if (RENDERER STREQUAL "dxbc")
      set(OPT -O3)
    endif ()
    execute_process(
      COMMAND "${SHADERC}" -i "${SRC_DIR}" -f "${SHADER}" -o "${BIN}" --type ${TYPE}
              --platform ${${RENDERER}_PLATFORM} -p ${${RENDERER}_PROFILE} ${OPT}
      RESULT_VARIABLE RESULT OUTPUT_VARIABLE LOG ERROR_VARIABLE LOG)
    if (NOT RESULT EQUAL 0)
      message(FATAL_ERROR "shaderc failed on ${NAME} for ${RENDERER}:\n${LOG}")
    endif ()

    file(READ "${BIN}" HEX HEX)
    file(REMOVE "${BIN}")
    string(LENGTH "${HEX}" HEX_LENGTH)
    math(EXPR SIZE "${HEX_LENGTH} / 2")
    # 24 bytes per line keeps the files diffable and the lines short.
    set(BYTES "")
    set(POS 0)
    while (POS LESS HEX_LENGTH)
      string(SUBSTRING "${HEX}" ${POS} 48 CHUNK)
      string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," CHUNK "${CHUNK}")
      string(APPEND BYTES "    ${CHUNK}\n")
      math(EXPR POS "${POS} + 48")
    endwhile ()
    string(APPEND CONTENTS "  static const unsigned char ${NAME}_data[] = {\n${BYTES}  };\n")
    string(APPEND CONTENTS "  EmbeddedFile ${NAME} { \"${NAME}\", ${NAME}_data, ${SIZE} };\n\n")
  endforeach ()

  string(APPEND CONTENTS "}\n")
  file(WRITE "${OUT_DIR}/shaders_${RENDERER}.cpp" "${CONTENTS}")
  message(STATUS "wrote compiled/shaders_${RENDERER}.cpp")
endforeach ()

# The header is the same for every renderer: one EmbeddedFile per shader.
set(HEADER "// Generated by shaders/compile_shaders.cmake from the .sc sources. Do not edit.\n")
string(APPEND HEADER "// One definition per shader, in compiled/shaders_<renderer>.cpp; a build\n")
string(APPEND HEADER "// compiles the file for its renderer (backends/gpu/gmpi_gpu.cmake).\n\n")
string(APPEND HEADER "#pragma once\n\n#include \"../../embedded_file.h\"\n\nnamespace gmpi::gpu::shaders {\n")
foreach (NAME ${NAMES})
  string(APPEND HEADER "  extern EmbeddedFile ${NAME};\n")
endforeach ()
string(APPEND HEADER "}\n")
file(WRITE "${OUT_DIR}/shaders.h" "${HEADER}")
message(STATUS "wrote compiled/shaders.h")
